    <dashboard enable-sort-zone-taborder='true' name='Dashboard 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='14'>Two Distinct Emission Patterns Emerge</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#898989' fontname='Tableau Light' fontsize='12' underline='true'>Upward tail</run>
            <run fontcolor='#898989' fontname='Tableau Light' fontsize='12'>: high fossil fuel use + low population size = high per-capita emissions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#898989' fontname='Tableau Light' fontsize='12' underline='true'>Rightward tail</run>
            <run fontcolor='#898989' fontname='Tableau Light' fontsize='12'>: large economies + large populations = high total emissions</run>
