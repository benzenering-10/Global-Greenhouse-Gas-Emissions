    <dashboard enable-sort-zone-taborder='true' name='Dashboard 2'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000'>Geographic Distribution of Emissions</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='14' underline='true'>Total Emissions</run>
            <run fontsize='12'> highlight the world&apos;s largest absolute contributors, driven by population and industrial activity</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='14' underline='true'>Per-capita Emissions</run>
            <run fontsize='12'>Æ </run>
            <run fontcolor='#000000' fontsize='12'>shifts our view to individual impact, revealing efficiency, lifestyle, and development differences that Total Values cannot show</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight='1169' maxwidth='1654' minheight='1169' minwidth='1654' preset-index='14' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98632' id='14' param='vert' type-v2='layout-flow' w='99032' x='484' y='684'>
