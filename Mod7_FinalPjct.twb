      <column caption='%ChangePerCapita' datatype='real' name='[Calculation_0898088978440192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10; { FIXED [country] : SUM(IF [year] = 2024 THEN [ghg_per_capita] END) }&#13;&#10; -&#13;&#10; { FIXED [country] : SUM(IF [year] = 1950 THEN [ghg_per_capita] END) }&#13;&#10;)&#13;&#10;/&#13;&#10;{ FIXED [country] : SUM(IF [year] = 1950 THEN [ghg_per_capita] END) }' />
